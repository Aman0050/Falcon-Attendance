{
  "expo": {
    "name": "Falcon Attendance",
    "slug": "falcon-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falconinfo.attendance",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Falcon Attendance requires your location to verify you are inside the office premises during check-in and check-out."
      }
    },
    "android": {
      "package": "com.falconinfo.attendance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Falcon Attendance to use your location to verify you are inside the office."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "8542a6b4-323b-4bac-b3e8-42a5ba83b624"
      }
    }
  }
}
